  "round": {
    "intermediaryNodeRunId": "01M5ACK73ZP3SF9YSKFJWQT6TJ",
    "askingNodeRunId": "01M5AC7P8Q5RW6Q9MJG25VSJ7T",
    "status": "awaiting_human",
    "questions": [
      {
        "mindmap": {
          "categoryPath": [
            "预约规则",
            "满员分配"
          ]
        },
        "id": "allocation-when-full",
        "title": "当 3 间会议室在同一时段都被占用时，第一版采用哪种分配规则？",
        "kind": "single",
        "recommended": false,
        "options": [
          {
            "label": "先到先得",
            "description": "规则透明、实现和解释成本最低；代价是手快的人可能长期占住热门时段，团队只能靠事后协调，缺少纠偏机制。",
            "recommended": false,
            "recommendationReason": ""
          },
          {
            "label": "按团队/角色配额或优先级分配",
            "description": "能给关键团队保留容量；代价是要先定义谁有优先级、由谁维护名单，容易引发公平性质疑，且增加管理成本。",
            "recommended": false,
            "recommendationReason": ""
          },
          {
            "label": "由管理员审批冲突预约",
            "description": "保留人工判断，适合需求差异大的情况；代价是预约依赖管理员响应，形成瓶颈，且审批标准不透明时争议更大。",
            "recommended": false,
            "recommendationReason": ""
          }
        ]
      },
      {
        "mindmap": {
          "categoryPath": [
            "交付形态",
            "预约入口"
          ]
        },
        "id": "booking-entry",
        "title": "第一版的预约入口以什么为主？",
        "kind": "single",
        "recommended": false,
        "options": [
          {
            "label": "独立网页（桌面/移动浏览器）",
            "description": "交付路径最短，不依赖现有系统；代价是团队要多打开一个地方，使用习惯需要重新建立。",
            "recommended": false,
            "recommendationReason": ""
          },
          {
            "label": "接入现有企业日历（若可用）",
            "description": "贴近日常查看习惯，减少重复录入；代价是接口、权限和可用性需先核实，若不可用或限制多，两周交付风险上升。",
            "recommended": false,
            "recommendationReason": ""
          },
          {
            "label": "聊天机器人/群内指令",
            "description": "在现有沟通场景里低门槛发起预约；代价是冲突展示和修改预约更弱，且依赖聊天平台能力与消息可靠性。",
            "recommended": false,
            "recommendationReason": ""
          },
          {
            "label": "管理员代订",
            "description": "实现最简单、规则最易统一；代价是成员不能自助预约，管理员成为瓶颈，使用数据也会混入代订行为。",
            "recommended": false,
            "recommendationReason": ""
          }
        ]
      },
      {
        "mindmap": {
          "categoryPath": [
            "爽约治理",
            "执行强度"
          ]
        },
        "id": "no-show-enforcement",
        "title": "第一版对“预约后未到会”的处理强度是什么？",
        "kind": "single",
        "recommended": false,
        "options": [
          {
            "label": "到点未使用则自动释放",
            "description": "能减少空占、提高周转；代价是可能误释放实际到会但未操作的预约，需要处理申诉和例外，规则过严会引发不满。",
            "recommended": false,
            "recommendationReason": ""
          },
          {
            "label": "仅提醒，不自动释放",
            "description": "保留预约者的控制权，冲突较小；代价是提醒可能被忽略，房间仍可能闲置，需要人工跟进。",
            "recommended": false,
            "recommendationReason": ""
          },
          {
            "label": "不提醒也不自动释放",
            "description": "实现和沟通成本最低；代价是爽约只能靠事后发现，热门时段浪费更隐蔽，也难以及时纠正。",
            "recommended": false,
            "recommendationReason": ""
          }
        ]
      },
      {
        "mindmap": {
          "categoryPath": [
            "预约规则",
            "时长上限"
          ]
        },
        "id": "max-duration",
        "title": "单次预约的最长时长设为多少？",
        "kind": "single",
        "recommended": false,
        "options": [
          {
            "label": "最长 1 小时",
            "description": "提高周转，适合短会；代价是长会要拆成多段或转线下，可能增加预约次数和协调成本。",
            "recommended": false,
            "recommendationReason": ""
          },
          {
            "label": "最长 2 小时",
            "description": "在周转和常见会议时长之间取中；代价是热门时段仍可能被半天占用，需要靠其他规则调节。",
            "recommended": false,
            "recommendationReason": ""
          },
          {
            "label": "最长 4 小时",
            "description": "容纳半天会议；代价是 3 间房很容易被少数长会占满，短期冲突可能上升。",
            "recommended": false,
            "recommendationReason": ""
          },
          {
            "label": "不设单次时长上限",
            "description": "最灵活，适合差异大的会议；代价是可能出现整天占用，容量被少数预约锁定，公平和周转风险最高。",
            "recommended": false,
            "recommendationReason": ""
          }
        ]
      },
      {
        "mindmap": {
          "categoryPath": [
            "验证安排",
            "证据来源"
          ]
        },
        "id": "baseline-evidence",
        "title": "在缺少历史基线的情况下，第一版上线后先用哪些证据来判断效果？",
        "kind": "multi",
        "recommended": false,
        "options": [
          {
            "label": "现有预约/群聊/邮件记录（若存在）",
            "description": "能低成本还原部分历史需求；代价是记录可能不完整、口径不一，只能作为参考，不能当作可靠基线。",
            "recommended": false,
            "recommendationReason": ""
          },
          {
            "label": "新系统内的预约、取消与满员日志",
            "description": "口径统一、可持续，能看需求时段和失败预约；代价是只覆盖上线后的行为，且需要提前埋点。",
            "recommended": false,
            "recommendationReason": ""
          },
          {
            "label": "实际到会与未到会观察（签到或人工抽查）",
            "description": "能直接看到爽约和空置；代价是需要人工投入，抽查样本可能不代表全周，且被观察时行为可能改变。",
            "recommended": false,
            "recommendationReason": ""
          },
          {
            "label": "使用者反馈与冲突求助记录",
            "description": "能解释冲突发生在哪些场景、规则是否被接受；代价是主观、零散，不能单独作为量化结论。",
            "recommended": false,
            "recommendationReason": ""
          }
        ]
      }
    ],
