{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../../packages/frontend/src/*"],
      "react": ["../../../packages/frontend/node_modules/react"],
      "react/*": ["../../../packages/frontend/node_modules/react/*"],
      "react-dom/*": ["../../../packages/frontend/node_modules/react-dom/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["./app.tsx", "./fixture.ts"]
}
