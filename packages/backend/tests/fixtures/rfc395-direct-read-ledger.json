{
  "rfc": "RFC-395 II-a A1",
  "reasonCategories": {
    "historical-schema": "Builds a frozen migration, upgrade, downgrade or backup shape; II-b replaces it with a converter fixture.",
    "legacy-null-seq": "Intentionally creates NULL-seq history for the old backfill or supersession oracle; II-b retires that path.",
    "legacy-storage-shape": "Exercises epoch-1 scalar/map checkpoint encoding, malformed checkpoint JSON, or mismatched stored repoCount/worktreeDirName; a target-model spec cannot express the physical storage assertion.",
    "native-persistence-protocol": "The native statement/affected-row protocol or row-by-row upsert is the oracle, not merely fixture setup.",
    "legacy-sql-dataset": "Prepares an offline SQLite source dataset for the existing PostgreSQL logical-migration/soak evidence; II-b converter replaces the epoch-1 SQL.",
    "fixture-codec": "The adapter codec test compares projection output with the epoch-1 encoding; II-b replaces this encoding oracle.",
    "legacy-sql-oracle": "The test or helper deliberately preserves the original epoch-1 SQL predicate/projection as the independent conformance oracle; II-b replaces this oracle.",
    "legacy-schema-contract": "Asserts the epoch-1 physical column name and native SQL type as the subject; II-b replaces the schema assertion."
  },
