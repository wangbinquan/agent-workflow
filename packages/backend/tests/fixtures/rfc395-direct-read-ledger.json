{
  "rfc": "RFC-395 II-a A1",
  "reasonCategories": {
    "historical-schema": "Builds or inspects a frozen epoch-1 migration/backup/conversion input; it is not a live epoch-2 fixture.",
    "legacy-null-seq": "Exercises frozen NULL-seq history through the isolated epoch-1 backfill or supersession oracle.",
    "legacy-storage-shape": "Exercises epoch-1 scalar/map checkpoint encoding, malformed checkpoint JSON, or mismatched stored repoCount/worktreeDirName; a target-model spec cannot express the physical storage assertion.",
    "native-persistence-protocol": "The native statement/affected-row protocol or row-by-row upsert is the oracle, not merely fixture setup.",
    "legacy-sql-dataset": "Prepares an offline SQLite source dataset for the existing PostgreSQL logical-migration/soak evidence; II-b converter replaces the epoch-1 SQL.",
    "fixture-codec": "Compares fixture or projection output with its explicitly selected storage encoding; frozen and target assertions remain distinct.",
    "legacy-sql-oracle": "The test or helper deliberately preserves the original epoch-1 SQL predicate/projection as the independent conformance oracle; II-b replaces this oracle.",
    "legacy-schema-contract": "Asserts the epoch-1 physical column name and native SQL type as the subject; II-b replaces the schema assertion.",
    "target-model-contract": "Asserts epoch-2 physical companions, relations, selection/CAS, rollback, codecs or malformed/history-only rows; these storage contracts intentionally bypass executable fixture construction.",
    "target-runtime-state": "The model builder creates the aggregate; the test then sets or inspects its existing workgroup runtime state to exercise gate, pause, result or dynamic-workflow transitions."
  },
